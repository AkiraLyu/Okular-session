[Desktop Entry]
Type=Application
Version=1.0
Name=Okular Session
GenericName=Document Viewer
Comment=Launch Okular with document session restore
Exec=okular-session %F
TryExec=okular-session
Icon=okular
Terminal=false
Categories=Office;Viewer;Qt;KDE;
MimeType=application/pdf;application/epub+zip;text/markdown;text/x-markdown;text/plain;
StartupWMClass=okular
Keywords=PDF;EPUB;Markdown;Text;Document;Viewer;Session;
